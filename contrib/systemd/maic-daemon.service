# The MAIC daemon as a systemd user service (docs/daemon.md). Written by `maic daemon unit install` from
# contrib/systemd/; `maic daemon unit remove` takes it away. MAIC still keeps its own PID file, lock and socket, so
# `maic daemon stop` and `maic daemon status` work the same under systemd.
[Unit]
Description=MAIC daemon: sessions that outlive the window they started in

[Service]
Type=simple
ExecStart=@MAIC@ daemon run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
