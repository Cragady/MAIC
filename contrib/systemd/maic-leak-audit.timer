# Runs maic-leak-audit.service every `every` from ~/.config/maic/audit.lua (docs/audit-trail.md). Written by
# `maic audit-trail schedule install`; run it again after changing `every`.
[Unit]
Description=MAIC leak audit, every @EVERY@

[Timer]
OnActiveSec=10min
OnUnitActiveSec=@EVERY@

[Install]
WantedBy=timers.target
