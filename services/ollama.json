{
  "name": "ollama",
  "description": "Local-only Ollama LLM server (see docs/ollama-setup.md)",
  "command": ["${HOME}/bin/ollama", "serve"],
  "env": {
    "OLLAMA_MODELS": "/run/media/cragady/Extra Storage/LinBox-Overflow/llm-models/ollama",
    "OLLAMA_HOST": "127.0.0.1:11434",
    "OLLAMA_NO_CLOUD": "1",
    "OLLAMA_REMOTES": "none.invalid",
    "OLLAMA_CLOUD_BASE_URL": "http://127.0.0.1:9"
  },
  "port": 11434,
  "requires": ["/run/media/cragady/Extra Storage/LinBox-Overflow/llm-models/ollama"],
  "ready_timeout": 30
}
