{
  "openrpc": "1.3.2",
  "info": {
    "title": "MAIC engine protocol",
    "version": "1",
    "description": "JSON-RPC 2.0, one message per line, between MAIC's engine and every interface (docs/design/engine-protocol.md). Names are OpenAI's where OpenAI's API description defines the concept (protocol/openai/), MAIC's own under maic. and in a maic object. Every method here is in the engine's dispatcher and the reverse (ctest protocol_schema). x-maic-remote says whether a remote client may call it; x-maic-params on a notification is the schema of its whole params object; errors carry OpenAI's error object in data (schemas/maic.schema.json#/$defs/ErrorData)."
  },
  "methods": [
    {
      "name": "maic.hello",
      "summary": "Opens the connection: the protocol version, who the client is, what it supports. Nothing else is accepted before it.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "protocol",
          "description": "The highest protocol version the client speaks.",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "client",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "name": "capabilities",
          "required": false,
          "schema": {
            "$ref": "schemas/maic.schema.json#/$defs/Capabilities"
          }
        },
        {
          "name": "view",
          "required": false,
          "schema": {
            "type": "object",
            "properties": {
              "collapse_over": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "name": "auth",
          "description": "Remote transports only: the token or the account's access token.",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "hello",
        "schema": {
          "$ref": "schemas/maic.schema.json#/$defs/HelloResult"
        }
      },
      "x-maic-remote": true
    },
    {
      "name": "maic.engine.status",
