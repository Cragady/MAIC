    "maid.tool.output.delta": {
      "description": "A script tool's stderr, or a Lua tool's maid.shell output, while it runs: `data`, or `skipped` bytes not sent to this connection. A `!cmd` (maid.session.shell) streams the same way with its own item_id and no output_index: it is no response's item.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.tool.output.delta"
            },
            "item_id": {
              "type": "string"
            },
            "output_index": {
              "type": "integer",
              "minimum": 0,
              "description": "The output item it streams under; absent for a `!cmd`."
            },
            "call": {
              "description": "A subagent's call (<agent>:<call id>) streaming under the task's output item; offset is then within that call.",
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "data": {
              "type": "string"
            },
            "skipped": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "item_id",
            "offset"
          ]
        }
      ]
    },
    "maid.file.written": {
