    "maid.session.state": {
      "description": "The session's lifecycle and activity. The first event of every load is one, and it carries the stream's header: the epoch, the protocol hash and, for a new epoch, what it replaced, forked from, or (a background task) the parent and call that started it.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.session.state"
            },
            "state": {
              "$ref": "maid.schema.json#/$defs/SessionState"
            },
            "activity": {
              "$ref": "maid.schema.json#/$defs/Activity"
            },
            "waiting": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "maid.schema.json#/$defs/Waiting"
                }
              ]
            },
            "by": {
              "$ref": "maid.schema.json#/$defs/By"
            },
            "epoch": {
              "description": "The history incarnation this stream belongs to: kept across loads while the history is unchanged, new when it starts fresh, is reset, forked or rewritten. maid.session.subscribe takes it back.",
              "type": "string",
              "minLength": 1
            },
            "protocol": {
              "description": "The protocol this load speaks: the digest of protocol/ in RFC 8785 form (maid protocol hash), and that form's name.",
              "type": "object",
              "properties": {
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "canonical": {
                  "const": "RFC 8785"
                }
              },
              "required": [
                "hash",
                "canonical"
              ]
            },
            "previous_epoch": {
              "description": "A new epoch's predecessor in the same session, and why it was replaced.",
              "type": "object",
              "properties": {
                "epoch": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "epoch"
              ]
            },
            "forked_from": {
              "description": "A forked session's first epoch: the parent session, its epoch and the transcript records the fork holds.",
              "type": "object",
              "properties": {
                "session": {
                  "type": "string"
                },
                "epoch": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "records": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "session",
                "records"
              ]
            },
            "parent": {
              "description": "A background task's first epoch: the session whose task call started it, that session's epoch, the call, and the sequence_number of the maid.task.created on its stream.",
              "type": "object",
              "properties": {
                "session": {
                  "type": "string"
                },
                "epoch": {
                  "type": "string"
                },
                "call_id": {
                  "type": "string"
                },
                "sequence_number": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "session",
                "epoch",
                "call_id",
                "sequence_number"
              ]
            }
          },
          "required": [
            "type",
            "state",
            "activity",
            "waiting"
          ]
        }
      ]
    },
