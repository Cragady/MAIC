{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "maic.event: one session event",
  "description": "The params of a maic.event notification: one event, exactly as the Responses WebSocket would send it, plus stream_id (the session id). The union over `type`, as OpenAI's ResponseStreamEvent is: OpenAI's events by $ref into ../openai/subset.json, then MAIC's own maic.* events. Exactly the types the engine emits (docs/design/engine-protocol.md, section 3); the order they come in is ordering.json.",
  "anyOf": [
    {
      "$ref": "#/$defs/response.created"
    },
    {
      "$ref": "#/$defs/response.in_progress"
    },
    {
      "$ref": "#/$defs/response.completed"
    },
    {
      "$ref": "#/$defs/response.failed"
    },
    {
      "$ref": "#/$defs/response.incomplete"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/response.steer.accepted"
    },
    {
      "$ref": "#/$defs/response.steer.failed"
    },
    {
      "$ref": "#/$defs/response.output_item.added"
    },
    {
      "$ref": "#/$defs/response.output_item.done"
    },
    {
      "$ref": "#/$defs/response.content_part.added"
    },
    {
      "$ref": "#/$defs/response.content_part.done"
    },
    {
      "$ref": "#/$defs/response.output_text.delta"
    },
    {
      "$ref": "#/$defs/response.output_text.done"
    },
    {
      "$ref": "#/$defs/response.reasoning_text.delta"
    },
    {
      "$ref": "#/$defs/response.reasoning_text.done"
    },
    {
      "$ref": "#/$defs/response.function_call_arguments.done"
    },
    {
      "$ref": "#/$defs/response.shell_call_command.added"
    },
    {
      "$ref": "#/$defs/response.shell_call_command.done"
    },
    {
      "$ref": "#/$defs/response.shell_call_output_content.delta"
    },
    {
      "$ref": "#/$defs/response.shell_call_output_content.done"
    },
    {
      "$ref": "#/$defs/maic.response.cancelled"
    },
    {
      "$ref": "#/$defs/maic.steer.applied"
    },
    {
      "$ref": "#/$defs/maic.turn.paused"
    },
    {
      "$ref": "#/$defs/maic.input.added"
    },
    {
      "$ref": "#/$defs/maic.approval.requested"
    },
    {
      "$ref": "#/$defs/maic.approval.answered"
    },
    {
      "$ref": "#/$defs/maic.question.asked"
    },
    {
      "$ref": "#/$defs/maic.question.answered"
    },
    {
      "$ref": "#/$defs/maic.tool.output.delta"
    },
    {
      "$ref": "#/$defs/maic.file.written"
    },
    {
      "$ref": "#/$defs/maic.notice"
    },
    {
      "$ref": "#/$defs/maic.todo.updated"
    },
    {
      "$ref": "#/$defs/maic.session.state"
    },
    {
      "$ref": "#/$defs/maic.session.settings"
    },
    {
      "$ref": "#/$defs/maic.session.title"
    },
    {
      "$ref": "#/$defs/maic.usage.updated"
    }
  ],
  "$defs": {
    "Envelope": {
      "description": "What every event carries: OpenAI's `type` and `sequence_number`, and `stream_id`, the session's id, as the Responses WebSocket echoes its lane.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "sequence_number",
        "stream_id"
      ]
    },
    "Maic": {
      "description": "MAIC's fields on an OpenAI event.",
      "type": "object"
    },
    "response.created": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseCreatedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            },
            "response": {
              "type": "object",
              "properties": {
                "maic": {
                  "$ref": "maic.schema.json#/$defs/ResponseMaic"
                }
              },
              "required": [
                "maic"
              ]
            }
          }
        }
      ]
    },
    "response.in_progress": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseInProgressEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            },
            "response": {
              "type": "object",
              "properties": {
                "maic": {
                  "$ref": "maic.schema.json#/$defs/ResponseMaic"
                }
              },
              "required": [
                "maic"
              ]
            }
          }
        }
      ]
    },
    "response.completed": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseCompletedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            },
            "response": {
              "type": "object",
              "properties": {
                "maic": {
                  "$ref": "maic.schema.json#/$defs/ResponseMaic"
                }
              },
              "required": [
                "maic"
              ]
            }
          }
        }
      ]
    },
    "response.failed": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseFailedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            },
            "response": {
              "type": "object",
              "properties": {
                "maic": {
                  "$ref": "maic.schema.json#/$defs/ResponseMaic"
                }
              },
              "required": [
                "maic"
              ]
            }
          }
        }
      ]
    },
    "response.incomplete": {
      "description": "A response that stopped short. `incomplete_details.reason: \"steered\"` when a steer ended it at a boundary; its successor's response.created follows.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseIncompleteEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            },
            "response": {
              "type": "object",
              "properties": {
                "maic": {
                  "$ref": "maic.schema.json#/$defs/ResponseMaic"
                }
              },
              "required": [
                "maic"
              ]
            }
          }
        }
      ]
    },
    "error": {
      "description": "OpenAI's error event: a halted turn's (`code: \"maic_halted\"`, the halt message), before its maic.response.cancelled.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseErrorEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.steer.accepted": {
      "description": "The engine owns a steer's input (response.steer, or maic.steer's steer, drop and further); the successor's response.created commits it.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseSteerAcceptedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.steer.failed": {
      "description": "Accepted input that cannot be committed (a keep or halt ended the turn first), returned with OpenAI's steering error code.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseSteerFailedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.output_item.added": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseOutputItemAddedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            },
            "item": {
              "type": "object",
              "properties": {
                "maic": {
                  "$ref": "maic.schema.json#/$defs/ItemMaic"
                }
              }
            }
          }
        }
      ]
    },
    "response.output_item.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseOutputItemDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            },
            "item": {
              "type": "object",
              "properties": {
                "maic": {
                  "$ref": "maic.schema.json#/$defs/ItemMaic"
                }
              }
            }
          }
        }
      ]
    },
    "response.content_part.added": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseContentPartAddedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.content_part.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseContentPartDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.output_text.delta": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseTextDeltaEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "type": "object",
              "properties": {
                "merged_from": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ],
      "description": "A slow connection may get several deltas of one item merged into one, carrying the last sequence_number and maic.merged_from, the first it covers."
    },
    "response.output_text.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseTextDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.reasoning_text.delta": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseReasoningTextDeltaEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "type": "object",
              "properties": {
                "merged_from": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "response.reasoning_text.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseReasoningTextDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.function_call_arguments.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseFunctionCallArgumentsDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.shell_call_command.added": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallCommandAddedStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.shell_call_command.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallCommandDoneStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "response.shell_call_output_content.delta": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallOutputContentDeltaStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "offset"
              ]
            }
          },
          "required": [
            "maic"
          ]
        }
      ],
      "description": "run_shell's output while it runs. maic.offset is the byte offset in the whole output; maic.skipped, with an empty delta, counts bytes not sent to this connection."
    },
    "response.shell_call_output_content.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallOutputContentDoneStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maic": {
              "$ref": "#/$defs/Maic"
            }
          }
        }
      ]
    },
    "maic.response.cancelled": {
      "description": "A response ended by cancelResponse, or by an interrupt (final: false, the turn paused) or a halt steer: OpenAI defines no stream event for a cancelled response, so MAIC adds one.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maic.response.cancelled"
            },
            "response": {
              "allOf": [
                {
                  "$ref": "maic.schema.json#/$defs/MaicResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "cancelled"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "type",
            "response"
          ]
        }
      ]
    },
    "maic.steer.applied": {
      "description": "One of the six steering actions (section 11), before every event it causes: what it trimmed, which approvals and questions it withdrew, the tool it cancelled or waits for.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maic.steer.applied"
            },
            "steer": {
              "description": "The steer's id.",
              "type": "string",
              "minLength": 1
            },
            "action": {
              "$ref": "maic.schema.json#/$defs/SteerAction"
            },
            "trigger": {
              "enum": [
                "client",
                "ban"
              ]
            },
            "by": {
              "$ref": "maic.schema.json#/$defs/By"
            },
            "ban": {
              "description": "A ban's steer: which entry fired, never the matched text.",
              "type": "object",
              "properties": {
                "list": {
                  "enum": [
                    "strings",
                    "patterns"
                  ]
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "list",
                "index"
              ]
            },
            "note": {
              "type": "string"
            },
            "trimmed": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "item_id": {
                      "type": "string"
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "item_id",
                    "from",
                    "to"
                  ]
                }
              ]
            },
            "withdrawn": {
              "description": "The approvals and questions it withdrew.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cancelled_tool": {
              "description": "The call it stopped, by call_id.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "waits_for": {
              "description": "A steer that waits: the running call's call_id, the open approval or question, or \"boundary\" (the end of the model call).",
              "type": "string"
            }
          },
          "required": [
            "type",
            "steer",
            "action",
            "trigger",
            "by",
            "trimmed",
            "withdrawn",
            "cancelled_tool"
          ]
        }
      ]
    },
    "maic.turn.paused": {
      "description": "An interrupt paused the turn after its response was cancelled (final: false); a steer or a message resumes it, keep, halt or cancelResponse ends it.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maic.turn.paused"
            },
            "turn": {
              "type": "integer",
              "minimum": 1
            },
            "steer": {
              "type": "string",
              "minLength": 1
            },
            "response_id": {
              "description": "The paused turn's last response.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "turn",
            "steer",
            "response_id"
          ]
        }
      ]
    },
    "maic.input.added": {
      "description": "What a person typed, naming the client it came from; queued when it was delivered into a running response.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maic.input.added"
            },
            "item": {
              "allOf": [
                {
                  "$ref": "../openai/subset.json#/components/schemas/InputMessage"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "const": "user"
                    },
                    "maic": {
                      "type": "object",
                      "properties": {
                        "images": {
                          "description": "The pictures attached to this message, by name.",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ]
                }
              ]
            },
            "queued": {
              "type": "boolean"
            },
            "by": {
              "$ref": "maic.schema.json#/$defs/By"
            }
          },
          "required": [
            "type",
            "item",
            "queued",
            "by"
          ]
        }
      ]
    },
    "maic.approval.requested": {
      "description": "An action waits for a person. Raised on the top-level session's stream, `thread` naming a subagent's.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maic.approval.requested"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "call_id": {
              "description": "The call this approval is about; absent for a subagent's (then `thread` names it).",
              "type": "string"
            },
            "item_id": {
              "type": "string"
            },
            "thread": {
              "$ref": "maic.schema.json#/$defs/Thread"
            },
            "tool": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "origin": {
              "$ref": "maic.schema.json#/$defs/Origin"
            },
            "always_covers": {
              "type": "string"
            },
            "preview": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "proposed_size": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "id",
            "tool",
            "summary",
            "reason",
            "origin",
            "always_covers",
            "preview"
          ]
        }
      ]
    },
    "maic.approval.answered": {
      "description": "The first valid answer; every client closes its prompt.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maic.approval.answered"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "call_id": {
              "type": "string"
            },
            "choice": {
              "enum": [
                "yes",
                "no",
                "always",
                "trip",
                "withdrawn"
              ]
            },
            "by": {
              "$ref": "maic.schema.json#/$defs/By"
            }
          },
          "required": [
            "type",
            "id",
            "choice",
            "by"
          ]
        }
      ]
    },
    "maic.question.asked": {
      "description": "The question tool: the model asks the person.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maic.question.asked"
            },
