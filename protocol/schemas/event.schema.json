{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "maid.event: one session event",
  "description": "The params of a maid.event notification: one event, exactly as the Responses WebSocket would send it, plus stream_id (the session id). The union over `type`, as OpenAI's ResponseStreamEvent is: OpenAI's events by $ref into ../openai/subset.json, then MAID's own maid.* events. Exactly the types the engine emits (docs/design/engine-protocol.md, section 3); the order they come in is ordering.json.",
  "anyOf": [
    {
      "$ref": "#/$defs/response.created"
    },
    {
      "$ref": "#/$defs/response.in_progress"
    },
    {
      "$ref": "#/$defs/response.completed"
    },
    {
      "$ref": "#/$defs/response.failed"
    },
    {
      "$ref": "#/$defs/response.incomplete"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/response.steer.accepted"
    },
    {
      "$ref": "#/$defs/response.steer.failed"
    },
    {
      "$ref": "#/$defs/response.output_item.added"
    },
    {
      "$ref": "#/$defs/response.output_item.done"
    },
    {
      "$ref": "#/$defs/response.content_part.added"
    },
    {
      "$ref": "#/$defs/response.content_part.done"
    },
    {
      "$ref": "#/$defs/response.output_text.delta"
    },
    {
      "$ref": "#/$defs/response.output_text.done"
    },
    {
      "$ref": "#/$defs/response.reasoning_text.delta"
    },
    {
      "$ref": "#/$defs/response.reasoning_text.done"
    },
    {
      "$ref": "#/$defs/response.function_call_arguments.done"
    },
    {
      "$ref": "#/$defs/response.shell_call_command.added"
    },
    {
      "$ref": "#/$defs/response.shell_call_command.done"
    },
    {
      "$ref": "#/$defs/response.shell_call_output_content.delta"
    },
    {
      "$ref": "#/$defs/response.shell_call_output_content.done"
    },
    {
      "$ref": "#/$defs/maid.response.cancelled"
    },
    {
      "$ref": "#/$defs/maid.steer.applied"
    },
    {
      "$ref": "#/$defs/maid.turn.paused"
    },
    {
      "$ref": "#/$defs/maid.input.added"
    },
    {
      "$ref": "#/$defs/maid.approval.requested"
    },
    {
      "$ref": "#/$defs/maid.approval.answered"
    },
    {
      "$ref": "#/$defs/maid.question.asked"
    },
    {
      "$ref": "#/$defs/maid.question.answered"
    },
    {
      "$ref": "#/$defs/maid.tool.output.delta"
    },
    {
      "$ref": "#/$defs/maid.file.written"
    },
    {
      "$ref": "#/$defs/maid.notice"
    },
    {
      "$ref": "#/$defs/maid.todo.updated"
    },
    {
      "$ref": "#/$defs/maid.session.state"
    },
    {
      "$ref": "#/$defs/maid.session.settings"
    },
    {
      "$ref": "#/$defs/maid.session.title"
    },
    {
      "$ref": "#/$defs/maid.usage.updated"
    },
    {
      "$ref": "#/$defs/maid.task.created"
    },
    {
      "$ref": "#/$defs/maid.task.completed"
    },
    {
      "$ref": "#/$defs/maid.task.failed"
    }
  ],
  "$defs": {
    "Envelope": {
      "description": "What every event carries: OpenAI's `type` and `sequence_number`, and `stream_id`, the session's id, as the Responses WebSocket echoes its lane.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "maid": {
          "type": "object",
          "properties": {
            "filtered_from": {
              "description": "The first sequence_number filtered out of this connection's stream (maid.hello's `exclude`) since the last event it was sent: the numbers from it up to this event's, or its merged_from's, are accounted for.",
              "type": "integer",
              "minimum": 0
            },
            "cause": {
              "description": "The sequence_number of the event that caused this one, where OpenAI's own fields do not already say it: on response.created, the maid.input.added of the input the response answers.",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "type",
        "sequence_number",
        "stream_id"
      ]
    },
    "Maid": {
      "description": "MAID's fields on an OpenAI event.",
      "type": "object"
    },
    "response.created": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseCreatedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            },
            "response": {
              "type": "object",
              "properties": {
                "maid": {
                  "$ref": "maid.schema.json#/$defs/ResponseMaid"
                }
              },
              "required": [
                "maid"
              ]
            }
          }
        }
      ]
    },
    "response.in_progress": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseInProgressEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            },
            "response": {
              "type": "object",
              "properties": {
                "maid": {
                  "$ref": "maid.schema.json#/$defs/ResponseMaid"
                }
              },
              "required": [
                "maid"
              ]
            }
          }
        }
      ]
    },
    "response.completed": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseCompletedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            },
            "response": {
              "type": "object",
              "properties": {
                "maid": {
                  "$ref": "maid.schema.json#/$defs/ResponseMaid"
                }
              },
              "required": [
                "maid"
              ]
            }
          }
        }
      ]
    },
    "response.failed": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseFailedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            },
            "response": {
              "type": "object",
              "properties": {
                "maid": {
                  "$ref": "maid.schema.json#/$defs/ResponseMaid"
                }
              },
              "required": [
                "maid"
              ]
            }
          }
        }
      ]
    },
    "response.incomplete": {
      "description": "A response that stopped short. `incomplete_details.reason: \"steered\"` when a steer ended it at a boundary; its successor's response.created follows.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseIncompleteEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            },
            "response": {
              "type": "object",
              "properties": {
                "maid": {
                  "$ref": "maid.schema.json#/$defs/ResponseMaid"
                }
              },
              "required": [
                "maid"
              ]
            }
          }
        }
      ]
    },
    "error": {
      "description": "OpenAI's error event: a halted turn's (`code: \"maid_halted\"`, the halt message), before its maid.response.cancelled.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseErrorEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.steer.accepted": {
      "description": "The engine owns a steer's input (response.steer, or maid.steer's steer, drop and further); the successor's response.created commits it.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseSteerAcceptedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.steer.failed": {
      "description": "Accepted input that cannot be committed (a keep or halt ended the turn first), returned with OpenAI's steering error code.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseSteerFailedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.output_item.added": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseOutputItemAddedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            },
            "item": {
              "type": "object",
              "properties": {
                "maid": {
                  "$ref": "maid.schema.json#/$defs/ItemMaid"
                }
              }
            }
          }
        }
      ]
    },
    "response.output_item.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseOutputItemDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            },
            "item": {
              "type": "object",
              "properties": {
                "maid": {
                  "$ref": "maid.schema.json#/$defs/ItemMaid"
                }
              }
            }
          }
        }
      ]
    },
    "response.content_part.added": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseContentPartAddedEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.content_part.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseContentPartDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.output_text.delta": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseTextDeltaEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "type": "object",
              "properties": {
                "merged_from": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ],
      "description": "A slow connection may get several deltas of one item merged into one, carrying the last sequence_number and maid.merged_from, the first it covers."
    },
    "response.output_text.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseTextDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.reasoning_text.delta": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseReasoningTextDeltaEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "type": "object",
              "properties": {
                "merged_from": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "response.reasoning_text.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseReasoningTextDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.function_call_arguments.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseFunctionCallArgumentsDoneEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.shell_call_command.added": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallCommandAddedStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.shell_call_command.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallCommandDoneStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "response.shell_call_output_content.delta": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallOutputContentDeltaStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "offset"
              ]
            }
          },
          "required": [
            "maid"
          ]
        }
      ],
      "description": "run_shell's output while it runs. maid.offset is the byte offset in the whole output; maid.skipped, with an empty delta, counts bytes not sent to this connection."
    },
    "response.shell_call_output_content.done": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "$ref": "../openai/subset.json#/components/schemas/ResponseShellCallOutputContentDoneStreamingEvent"
        },
        {
          "type": "object",
          "properties": {
            "maid": {
              "$ref": "#/$defs/Maid"
            }
          }
        }
      ]
    },
    "maid.response.cancelled": {
      "description": "A response ended by cancelResponse, or by an interrupt (final: false, the turn paused) or a halt steer: OpenAI defines no stream event for a cancelled response, so MAID adds one.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.response.cancelled"
            },
            "response": {
              "allOf": [
                {
                  "$ref": "maid.schema.json#/$defs/MaidResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "cancelled"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "type",
            "response"
          ]
        }
      ]
    },
    "maid.steer.applied": {
      "description": "One of the six steering actions (section 11), before every event it causes: what it trimmed, which approvals and questions it withdrew, the tool it cancelled or waits for.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.steer.applied"
            },
            "steer": {
              "description": "The steer's id.",
              "type": "string",
              "minLength": 1
            },
            "action": {
              "$ref": "maid.schema.json#/$defs/SteerAction"
            },
            "trigger": {
              "enum": [
                "client",
                "ban"
              ]
            },
            "by": {
              "$ref": "maid.schema.json#/$defs/By"
            },
            "ban": {
              "description": "A ban's steer: which entry fired, never the matched text.",
              "type": "object",
              "properties": {
                "list": {
                  "enum": [
                    "strings",
                    "patterns"
                  ]
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "list",
                "index"
              ]
            },
            "note": {
              "type": "string"
            },
            "trimmed": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "item_id": {
                      "type": "string"
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "item_id",
                    "from",
                    "to"
                  ]
                }
              ]
            },
            "withdrawn": {
              "description": "The approvals and questions it withdrew.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cancelled_tool": {
              "description": "The call it stopped, by call_id.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "waits_for": {
              "description": "A steer that waits: the running call's call_id, the open approval or question, or \"boundary\" (the end of the model call).",
              "type": "string"
            }
          },
          "required": [
            "type",
            "steer",
            "action",
            "trigger",
            "by",
            "trimmed",
            "withdrawn",
            "cancelled_tool"
          ]
        }
      ]
    },
    "maid.turn.paused": {
      "description": "An interrupt paused the turn after its response was cancelled (final: false); a steer or a message resumes it, keep, halt or cancelResponse ends it.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.turn.paused"
            },
            "turn": {
              "type": "integer",
              "minimum": 1
            },
            "steer": {
              "type": "string",
              "minLength": 1
            },
            "response_id": {
              "description": "The paused turn's last response.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "turn",
            "steer",
            "response_id"
          ]
        }
      ]
    },
    "maid.input.added": {
      "description": "What a person typed, naming the client it came from; queued when it was delivered into a running response.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.input.added"
            },
            "item": {
              "allOf": [
                {
                  "$ref": "../openai/subset.json#/components/schemas/InputMessage"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "const": "user"
                    },
                    "maid": {
                      "type": "object",
                      "properties": {
                        "images": {
                          "description": "The pictures attached to this message, by name.",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "from": {
                          "$ref": "maid.schema.json#/$defs/From"
                        }
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ]
                }
              ]
            },
            "queued": {
              "type": "boolean"
            },
            "by": {
              "$ref": "maid.schema.json#/$defs/By"
            }
          },
          "required": [
            "type",
            "item",
            "queued",
            "by"
          ]
        }
      ]
    },
    "maid.approval.requested": {
      "description": "An action waits for a person. A foreground subagent's names it in `thread` (agent only); a background task's is raised on its own stream and on its parent's, `thread` naming the task's session there, and an answer on either settles both.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.approval.requested"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "call_id": {
              "description": "The call this approval is about; absent for a subagent's (then `thread` names it).",
              "type": "string"
            },
            "item_id": {
              "type": "string"
            },
            "thread": {
              "$ref": "maid.schema.json#/$defs/Thread"
            },
            "tool": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "origin": {
              "$ref": "maid.schema.json#/$defs/Origin"
            },
            "always_covers": {
              "type": "string"
            },
            "preview": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "proposed_size": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "id",
            "tool",
            "summary",
            "reason",
            "origin",
            "always_covers",
            "preview"
          ]
        }
      ]
    },
    "maid.approval.answered": {
      "description": "The first valid answer; every client closes its prompt.",
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "maid.approval.answered"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "call_id": {
              "type": "string"
            },
            "choice": {
              "enum": [
                "yes",
                "no",
                "always",
                "trip",
                "withdrawn"
              ]
            },
            "by": {
              "$ref": "maid.schema.json#/$defs/By"
            },
            "timed_out": {
              "type": "boolean",
              "description": "Present, true, only when nobody answered within approvals_timeout and the engine denied it on the user's behalf (`by` then names timeout)."
            }
          },
          "required": [
            "type",
            "id",
            "choice",
            "by"
          ]
        }
      ]
    },
    "maid.question.asked": {
