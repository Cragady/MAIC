#!/usr/bin/env bash
# diction's launcher: `maic diction ...` execs it with the arguments untouched. It finds the package beside it (the
# repository's diction/) or under share/maic (an installed copy) and runs diction.cli with the system python3.
# The mic needs webrtcvad; when python3 lacks it, diction re-runs itself under `uv run` with requirements.txt,
# so nothing is pip-installed anywhere.
set -euo pipefail
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [ -f "$here/cli.py" ]; then
    parent="$(dirname "$here")"
else
    parent="$(dirname "$here")/share/maic"
fi
[ -f "$parent/diction/cli.py" ] || { echo "maic-diction: no diction package at $parent/diction" >&2; exit 1; }
# -P: the package from PYTHONPATH, never a diction/ that happens to sit in the current directory.
PYTHONPATH="$parent${PYTHONPATH:+:$PYTHONPATH}" exec python3 -P -m diction.cli "$@"
