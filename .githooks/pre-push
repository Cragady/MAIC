#!/usr/bin/env bash
# Runs the quick build gate before anything leaves the machine. Not installed by itself: once per clone,
#     git config core.hooksPath .githooks
# and git runs it on every push. A failing build or ctest stops the push; `git push --no-verify` skips it.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec scripts/check.sh --quick
