# Writes a C++ source holding the protocol/ files' text (docs/design/engine-protocol.md section 15), so the engine
# validates against them with no file lookup at run time.
#   cmake -DROOT=<protocol dir> -DOUT=<file.cpp> -DFILES=<path,path,...> -P embed_protocol.cmake
# Each file becomes raw string chunks cut at line ends, every chunk under 60000 bytes (C++ asks compilers to take
# 65536 at least), joined again at run time.
string(REPLACE "," ";" FILES "${FILES}")
set(delim "maicproto")
set(body "")
foreach(rel IN LISTS FILES)
    file(READ "${ROOT}/${rel}" text)
    string(FIND "${text}" ")${delim}\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${rel} holds the raw string delimiter )${delim}\"")
    endif()
    string(APPEND body "    {\"${rel}\", {\n")
    string(LENGTH "${text}" left)
    while(left GREATER 0)
        if(left LESS 60000)
            set(chunk "${text}")
            set(text "")
        else()
            string(SUBSTRING "${text}" 0 60000 window)
            string(FIND "${window}" "\n" cut REVERSE)
            if(cut EQUAL -1)
                message(FATAL_ERROR "${rel} has a line longer than 60000 bytes")
            endif()
            math(EXPR cut "${cut} + 1")
            string(SUBSTRING "${text}" 0 ${cut} chunk)
            string(SUBSTRING "${text}" ${cut} -1 text)
        endif()
        string(APPEND body "        R\"${delim}(${chunk})${delim}\",\n")
        string(LENGTH "${text}" left)
    endwhile()
    string(APPEND body "    }},\n")
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed_protocol.cmake from protocol/; do not edit.\n#include \"protocol_files.hpp\"\n\nnamespace maic::protocol {\n\nconst std::vector<EmbeddedFile>& embedded_files() {\n    static const std::vector<EmbeddedFile> files = {\n${body}    };\n    return files;\n}\n\n}  // namespace maic::protocol\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
